# ===== أسرار النظام (للتشغيل المحلي فقط) =====
# انسخ هذا الملف إلى .env ثم عبّئ القيم.
# على GitHub Actions تُوضع هذه القيم في Settings → Secrets and variables → Actions
#
# 💡 طبقة التوافق: النظام يقبل أسماء بديلة للأسرار —
#    TELEGRAM_API_ID    ← API_ID / TG_API_ID / TELEGRAM_API
#    TELEGRAM_API_HASH  ← API_HASH / TG_API_HASH
#    TELEGRAM_SESSION   ← SESSION / STRING_SESSION / TELETHON_SESSION / TG_SESSION
#    GEMINI_API_KEY     ← GOOGLE_API_KEY / GOOGLE_AI_API_KEY / GEMINI_KEY
#    DATABASE_URL       ← POSTGRES_URL / POSTGRESQL_URL / NEON_DATABASE_URL / NEON_URL

# من https://my.telegram.org → API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# جلسة Telethon (يُولّدها سكربت scripts/login.py) — سرّية للغاية: من يملكها يتحكم بالحساب كاملاً
TELEGRAM_SESSION=

# مفتاح Gemini المجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (اختياري) قاعدة بيانات Postgres مجانية من https://neon.tech
# إذا تُركت فارغة يعمل النظام بوضع SQLite على الملف data/state.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
