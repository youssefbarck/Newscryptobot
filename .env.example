# ===== إلزامي — من BotFather =====
TELEGRAM_BOT_TOKEN=123456:AAHfk...your_token_here

# ===== إلزامي — معرف قناتك =====
# قناة عامة: @mychannel | قناة خاصة: -1001234567890
TELEGRAM_CHAT_ID=@newscrypto1m

# ===== اختياري — وسم القناة أسفل كل خبر =====
CHANNEL_TAG=@newscrypto1m

# ===== اختياري — مصادر إضافية أقوى =====
# مفتاح مجاني من cryptopanic.com (شعور السوق + العملات المرتبطة)
CRYPTOPANIC_API_KEY=
# مفتاح من coingecko.com (مصدر أخبار إضافي + أسعار أثبت)
COINGECKO_API_KEY=
# مفتاح مجاني من whale-alert.io (حركات حيتان لحظية)
WHALE_ALERT_API_KEY=

